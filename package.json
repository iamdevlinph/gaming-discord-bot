{
  "name": "gaming-discord-bot",
  "version": "1.0.0",
  "description": "A multi purpose discord gaming bot",
  "keywords": [
    "discord",
    "bot"
  ],
  "license": "ISC",
  "author": "github.com/iamdevlinph",
  "main": "index.js",
  "scripts": {
    "build": "tsup src/index.ts --minify",
    "dev": "tsx watch src/index.ts",
    "start": "npm run build; node dist/index.js",
    "cache:delete": "rm -rf src/utils/cache/cache-data.json",
    "cache:create": "echo '{}' >> src/utils/cache/cache-data.json",
    "cache:reset": "npm run cache:delete; npm run cache:create"
  },
  "dependencies": {
    "array.prototype.toreversed": "1.1.2",
    "discord.js": "14.17.3",
    "dotenv": "16.4.7"
  },
  "devDependencies": {
    "node-color-log": "12.0.1",
    "tsup": "8.3.6",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
